{
    "name": "OK.ru",
    "description": "Buscador y reproductor de OK.ru con autores, canales y series ordenadas por capítulo (usa un Worker propio)",
    "author": "cheito55",
    "authorUrl": "https://github.com/cheito55",
    "sourceUrl": "https://raw.githubusercontent.com/cheito55/Ok-worker/main/OkRuConfig.json",
    "repositoryUrl": "https://github.com/cheito55/Ok-worker",
    "scriptUrl": "./OkRuScript.js",
    "version": 3,
    "iconUrl": "./ok.png",
    "allowNetwork": true,
    "allowAllHttpHeaderAccess": true,
    "capabilities": {
        "search": true,
        "searchTypes": ["VIDEO"],
        "videoDetails": true,
        "channel": true,
        "channelContents": true
    },
    "settings": {
        "workerUrl": {
            "name": "URL del Worker",
            "description": "https://ok-worker.cheito55.workers.dev",
            "type": "TEXT",
            "default": ""
        },
        "apiKey": {
            "name": "API Key",
            "description": "Clave secreta configurada en tu Worker para proteger el acceso (opcional).",
            "type": "TEXT",
            "default": ""
        },
        "okCookie": {
            "name": "Cookie de OK.ru",
            "description": "Tu cookie de sesión de OK.ru. Se enviará al Worker en la cabecera X-Ok-Cookie.",
            "type": "TEXT",
            "default": ""
        }
    }
}
